{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Page Agent",
  "version": "1.2.3",
  "description": "Page Agent 从对话到可复用的产出",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "alarms",
    "offscreen",
    "webNavigation",
    "nativeMessaging",
    "cookies",
    "unlimitedStorage",
    "downloads",
    "debugger",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "sandbox": {
    "pages": ["sandbox/sandbox.html"]
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "open-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "打开侧边栏"
    },
    "close-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "关闭侧边栏"
    },
    "open-options": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "打开配置项"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-element-position-controller.js", "shared/recording-contract.js", "content/conversation-recorder.js", "content/page-action-visual-feedback.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["settings/system-settings.js", "agent/conversation-protocol.js", "agent/tool-result-projection.js", "ui/runtime-client.js", "ui/image-artifact-client.js", "ui/page-conversation-message-contract.js", "dependencies/marked/marked.min.js", "dependencies/dompurify/purify.min.js", "ui/code-editor.js", "ui/conversation-event-view.js", "ui/conversation-list-view.js", "ui/conversation-shared.js", "shared/sync-event-stream.js", "content/page-conversation-panel.js", "content/page-conversation-entry.js", "content/floating-status.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "apps/*", "ui/code-editor-frame.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Page Agent",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
