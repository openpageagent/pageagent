# 在项目根目录执行 cp ./docker/.env.example ./docker/.env，再按需填写；已有文件时合并所需项。
# 可选项默认注释，使用时移除变量行前的 #。
# 修改后在项目根目录执行：docker compose --env-file ./docker/.env -f ./docker/compose.yaml up -d --no-build --force-recreate
#
# compose.yaml 通过服务级 env_file 读取 docker/.env 中的配置，无需逐项添加 environment 映射。
# 命令行 --env-file 同时为 Compose 中的镜像名等变量提供插值。

# 首次初始化：至少 12 个字符，用于创建服务端身份并自动配对浏览器。
# 已有认证和浏览器配对凭据时可留空；已有服务端首次增加浏览器时填原密码。
# 此项不会重置已有密码，也不会恢复已撤销的配对。
PAGE_AGENT_PAIRING_PASSWORD=''

# 浏览器插件显示名称。默认沿用内置连接文件或插件已保存的名称；新实例为 Page Agent。
# PAGE_AGENT_CLIENT_NAME='d01-agent'

# 容器内连接的本地别名，默认“容器内 MCP”。不改变连接 ID。
# PAGE_AGENT_LOCAL_CONNECTION_ALIAS='d01-server'

# MCP Server 对外显示名称，默认容器 hostname。不改变服务端身份。
# PAGE_AGENT_SERVER_NAME='d01-mcp'

# 外部 HTTP MCP 客户端使用的 Bearer 令牌，与浏览器配对密码独立。
# 默认首次自动生成并显示，后续复用；需要指定或重置令牌时填写。
# PAGE_AGENT_HTTP_BEARER_TOKEN=''

# Selkies 画面编码，默认 jpeg。需要视频编码且客户端支持时可设为 h264enc。
# SELKIES_ENCODER='h264enc'

# 启动同步的桶名（Bucket）。默认沿用同步源的桶名，未指定时为 default。
# 须与界面中的桶名一致，配合 PAGE_AGENT_SYNC_VERSION 使用。
# 1–80 个字符，以英文字母或数字开头，仅允许英文字母、数字、下划线和连字符，不允许中文。
# 不能使用保留名称 constructor、prototype。
# PAGE_AGENT_BUCKET='project-a'

# 启动时加载的备份版本，必须已标记为可同步，例如 v000002。
# 默认不指定版本，不执行启动自动同步，也不会自动选择最新版本。
# PAGE_AGENT_SYNC_VERSION='v000002'

# 是否允许启动自动同步，默认 true，只接受 true 或 false。
# 需要禁用时设为 false；设为 true 仍需指定 PAGE_AGENT_SYNC_VERSION。
# PAGE_AGENT_AUTO_SYNC_ENABLED='false'

# 额外内置连接文件的容器内路径。默认读取随插件打包的 builtin-connections/index.json。
# 使用前在项目根目录将 docker/builtin-connections.example.json 复制到 data/builtin-connections.json 并填写。
# PAGE_AGENT_BUILTIN_CONNECTIONS_FILE='/data/builtin-connections.json'

# 可选模型密钥注入：将 svc_example 替换成模型配置页面的完整 ID，保留大小写。
# 每个模型单独添加一项，填写非空密钥后再启用，无需修改 compose.yaml。
# 未提供时保留已有密钥，新模型则没有密钥；密钥不进入配置备份。
# PAGE_AGENT_MODEL_API_KEY_svc_example='YOUR_API_KEY'

# 以下变量供 Compose / 构建脚本使用，容器内应用不读取这些值。

# Compose 项目名，默认 page-agent。同机多个实例使用不同名称，并调整宿主机端口。
# COMPOSE_PROJECT_NAME='page-agent'

# 最终应用镜像的完整名称和标签，默认 page-agent:latest。
# Compose 自动读取此项；build.sh 只读取 shell 环境，不自动加载 .env。
# 自定义镜像时，在构建前 export 同名同值的变量，确保构建和部署使用相同镜像。
# PAGE_AGENT_IMAGE='page-agent:1.1.0'

# Selkies 运行环境镜像，默认 page-agent-runtime:latest。
# 由 Compose 构建配置及 build.sh 使用；调用 build.sh 前仍需 export。
# PAGE_AGENT_RUNTIME_IMAGE='page-agent-runtime:latest'

# 以下两项仅供 build.sh 使用，默认值如下；自定义时在 shell 中 export。
# 基础工具层镜像。
# PAGE_AGENT_BASE_IMAGE='page-agent-base:latest'
# 浏览器层镜像。
# PAGE_AGENT_BROWSER_IMAGE='page-agent-browser:latest'
