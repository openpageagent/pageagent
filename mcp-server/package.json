{
  "name": "@page-agent/mcp-server",
  "version": "1.3.0",
  "description": "ARP/1 MCP transport for the Page Agent Extension",
  "main": "index.js",
  "bin": {
    "page-agent-mcp": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "build:single": "node scripts/build-single.js",
    "check": "node --check index.js && node --check http-api.js && node --check extension-request-broker.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arp",
    "resource-protocol",
    "chrome-extension",
    "edge-extension",
    "page-agent"
